{% extends 'base.html.twig' %}

{% block title %}Résultats de référencement | Alice CRM{% endblock %}

{% block body %}
    <h1>Résultats de référencement</h1>

    <table class="table">
        <caption class="visually-hidden">
            Liste des résultats de référencement Google
        </caption>

        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Classement Google</th>
                <th scope="col">Date</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>

        <tbody>
            {% for serp_result in serp_results %}
                <tr>
                    <td>{{ serp_result.id }}</td>
                    <td>{{ serp_result.googleRank }}</td>
                    <td>
                        {{ serp_result.date ? serp_result.date|date('d/m/Y') : '' }}
                    </td>
                    <td>
                        <a
                            href="{{ path('app_serp_result_show', {'id': serp_result.id}) }}"
                            aria-label="Afficher le résultat {{ serp_result.id }}"
                        >
                            Afficher
                        </a>

                        <a
                            href="{{ path('app_serp_result_edit', {'id': serp_result.id}) }}"
                            aria-label="Modifier le résultat {{ serp_result.id }}"
                        >
                            Modifier
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">
                        Aucun résultat trouvé
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_serp_result_new') }}">
        Créer un nouveau résultat
    </a>
{% endblock %}
