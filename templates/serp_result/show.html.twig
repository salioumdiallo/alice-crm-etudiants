{% extends 'base.html.twig' %}

{% block title %}Résultat de référencement | Alice CRM{% endblock %}

{% block body %}
    <h1>Résultat de référencement</h1>

    <table class="table">
        <caption class="visually-hidden">
            Détails du résultat de référencement
        </caption>

        <tbody>
            <tr>
                <th scope="row">Id</th>
                <td>{{ serp_result.id }}</td>
            </tr>

            <tr>
                <th scope="row">Classement Google</th>
                <td>{{ serp_result.googleRank }}</td>
            </tr>

            <tr>
                <th scope="row">Date</th>
                <td>
                    {{ serp_result.date ? serp_result.date|date('d/m/Y') : '' }}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_serp_result_index') }}">
        Retour à la liste
    </a>

    <a href="{{ path('app_serp_result_edit', {'id': serp_result.id}) }}">
        Modifier
    </a>

    {{ include('serp_result/_delete_form.html.twig') }}
{% endblock %}
