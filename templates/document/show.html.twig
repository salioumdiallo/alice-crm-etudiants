{% extends 'base.html.twig' %}

{% block title %}Document | Alice CRM{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1>Document</h1>

        <div
            class="button-go-back"
            role="button"
            tabindex="0"
            aria-label="Retour à la liste des documents"
            onclick="window.location.href='{{ path('app_document_list') }}';"
        >
            <i class="fa-sharp fa-solid fa-circle-chevron-left fa-2xl"></i>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table">
            <caption class="visually-hidden">
                Détails du document {{ document.name }}
            </caption>

            <thead>
                <tr>
                    <th scope="col">Nom</th>

                    <th scope="col">
                        <div class="d-flex justify-content-between align-items-center">
                            Description

                            {% if document.description|length > 100 %}
                                <span
                                    class="d-inline-block span-info-document-description btn-fa-action-eye"
                                    data-bs-toggle="tooltip"
                                    data-bs-title="Description complète : Afficher / Cacher"
                                    role="button"
                                    tabindex="0"
                                    aria-label="Afficher ou cacher la description complète"
                                >
                                    <i
                                        class="fa-solid fa-eye fa-xl button-eye-document-description"
                                        aria-hidden="true"
                                    ></i>
                                </span>
                            {% endif %}
                        </div>
                    </th>

                    <th scope="col">Date</th>
                    <th scope="col">Famille</th>

                    {% if isAuthorized %}
                        <th scope="col">Utilisateurs autorisés</th>
                    {% endif %}

                    <th scope="col">Actions</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>{{ document.name }}</td>

                    <td style="width: 30%;">
                        <div class="document-description">
                            {% if document.description|length > 100 %}
                                <div class="document-description-slice">
                                    {{ document.description|slice(0, 100) ~ ' ...' }}
                                </div>

                                <div class="document-description-complete">
                                    {{ document.description }}
                                </div>
                            {% else %}
                                {{ document.description }}
                            {% endif %}
                        </div>
                    </td>

                    <td>
                        {{ document.date ? document.date|date('d/m/Y') : '' }}
                    </td>

                    <td>
                        {{ document.family }}
                    </td>

                    {% if isAuthorized %}
                        <td>
                            <div>
                                {% for userElement in document.user.toArray() %}
                                    <div class="form-check">
                                        <input
                                            class="form-check-input"
                                            disabled
                                            type="checkbox"
                                            id="user_{{ userElement.id }}"
                                            name="document[user][]"
                                            value="{{ userElement.id }}"
                                            {% if document.user.contains(userElement) %}checked{% endif %}
                                        >

                                        <label
                                            class="form-check-label"
                                            for="user_{{ userElement.id }}"
                                        >
                                            {{ userElement.firstname|capitalize }}
                                            {{ userElement.lastname|upper }}

                                            {% if userElement.status %}
                                                | {{ userElement.status|upper }}
                                            {% endif %}
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        </td>
                    {% endif %}

                    <td>
                        <div class="d-flex justify-content-around">
                            {% if isAuthorized %}
                                <a
                                    href="{{ path('app_document_edit', {'id': document.id}) }}"
                                    class="btn-fa-action-list mx-1"
                                    aria-label="Modifier le document {{ document.name }}"
                                >
                                    <i
                                        class="fa-solid fa-pen-to-square fa-xl"
                                        aria-hidden="true"
                                    ></i>
                                </a>
                            {% endif %}

                            <a
                                href="{{ path('app_document_file', {'id': document.id}) }}"
                                download
                                class="btn-fa-action-list mx-1"
                                aria-label="Télécharger le document {{ document.name }}"
                            >
                                <i
                                    class="fa-solid fa-download fa-xl"
                                    aria-hidden="true"
                                ></i>
                            </a>

                            {% if isAuthorized %}
                                {{ include('document/_delete_form.html.twig') }}
                            {% endif %}
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="embed-container ms-lg-5">
        {% if document.fileName|lower ends with('.pdf') %}
            <embed
                src="{{ path('app_document_file', {'id': document.id}) }}"
                type="application/pdf"
                title="{{ document.name }}"
                width="300"
                height="1000"
            >
        {% else %}
            <img
                src="{{ path('app_document_file', {'id': document.id}) }}"
                alt="{{ document.name }}"
                class="img-embed-document"
            >
        {% endif %}
    </div>
{% endblock %}
