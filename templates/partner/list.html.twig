{% extends 'base.html.twig' %}

{% block title %}Partenariats | Alice CRM{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1>Les Partenariats</h1>

        <div
            class="button-go-back"
            role="button"
            tabindex="0"
            aria-label="Retour à la page précédente"
            onclick="window.history.back();"
        >
            <i
                class="fa-sharp fa-solid fa-circle-chevron-left fa-2xl"
                aria-hidden="true"
            ></i>
        </div>
    </div>

    {% if partners is not empty %}
        <div class="d-flex justify-content-center justify-content-lg-end me-2">
            <a
                href="{{ path('app_partner_add') }}"
                class="btn btn-alice"
            >
                Nouveau Partenariat
            </a>
        </div>

        <table class="table mt-3">
            <caption class="visually-hidden">
                Liste des partenariats et de leurs tarifs
            </caption>

            <thead>
                <tr>
                    <th scope="col">Nom</th>
                    <th scope="col">Tarif</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for partner in partners %}
                    <tr>
                        <td>{{ partner.name }}</td>
                        <td>{{ partner.discountRate }} %</td>
                        <td>
                            <div class="d-flex justify-content-start">
                                <a
                                    href="{{ path('app_partner_show', {'id': partner.id}) }}"
                                    class="btn-fa-action-eye m-0"
                                    aria-label="Afficher le partenariat {{ partner.name }}"
                                >
                                    <i
                                        class="fa-solid fa-eye fa-xl"
                                        aria-hidden="true"
                                    ></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">
                            Aucun partenariat n'est encore défini.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <h4 class="mb-5">Aucun partenariat</h4>

        <div class="d-flex flex-column flex-md-row col-12 justify-content-around">
            <div class="card col-md-5 bgg-alice-light m-2">
                <div class="d-flex flex-column align-items-center card-body justify-content-between">
                    <h6 class="card-title mb-2">
                        Souhaitez-vous ajouter un partenariat ?
                    </h6>

                    <a
                        href="{{ path('app_partner_add') }}"
                        class="btn btn-alice"
                    >
                        Nouveau Partenariat
                    </a>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
